# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings -> Environment Variables.

# Get a free API key at https://resend.com (100 emails/day free tier)
RESEND_API_KEY=

# The email address that should receive contact form submissions
CONTACT_TO_EMAIL=you@example.com

# The "from" address Resend sends as (must be a verified domain in Resend,
# or use onboarding@resend.dev for testing before you verify your own domain)
CONTACT_FROM_EMAIL=onboarding@resend.dev
